{
  "config": {
    "step": {
      "user": {
        "title": "Homekeeper",
        "description": "Shared household duties. Add people, modules and duties from the integration page afterwards."
      }
    },
    "abort": {
      "single_instance_allowed": "Homekeeper is already set up."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Homekeeper options",
        "description": "Map condition names to sensors, one per line: name=sensor.entity_id",
        "data": {
          "conditions": "Conditions"
        }
      }
    }
  },
  "config_subentries": {
    "person": {
      "initiate_flow": {
        "user": "Add person",
        "reconfigure": "Edit person"
      },
      "entry_type": "Person",
      "step": {
        "user": {
          "title": "Person",
          "data": {
            "id": "ID (short, no spaces)",
            "name": "Name",
            "role": "Role",
            "language": "Notification language",
            "notify": "Notify service (e.g. notify.mobile_app_phone)",
            "quiet_start": "Quiet hours start (HH:MM)",
            "quiet_end": "Quiet hours end (HH:MM)",
            "person_entity": "Home Assistant person (links their login to this person)"
          }
        }
      },
      "error": {
        "bad_id": "Use lowercase letters, numbers, - and _.",
        "id_exists": "That ID is already used.",
        "quiet_both": "Set both quiet hours times, or neither."
      },
      "abort": {
        "reconfigure_successful": "Saved."
      }
    },
    "module": {
      "initiate_flow": {
        "user": "Add module",
        "reconfigure": "Edit module"
      },
      "entry_type": "Module",
      "step": {
        "user": {
          "title": "Module",
          "data": {
            "id": "ID",
            "title_en": "Title (English)",
            "title_ar": "Title (Arabic)",
            "owners": "Default owners"
          }
        }
      },
      "error": {
        "bad_id": "Use lowercase letters, numbers, - and _.",
        "id_exists": "That ID is already used."
      },
      "abort": {
        "reconfigure_successful": "Saved."
      }
    },
    "duty": {
      "initiate_flow": {
        "user": "Add duty",
        "reconfigure": "Edit duty"
      },
      "entry_type": "Duty",
      "step": {
        "user": {
          "title": "Duty",
          "data": {
            "id": "ID (short, no spaces)",
            "module": "Module",
            "title_en": "Title (English)",
            "title_ar": "Title (Arabic)",
            "owners": "Owners",
            "observers": "Extra observers",
            "schedule_type": "Schedule type"
          }
        },
        "schedule": {
          "title": "Schedule: {type}",
          "description": "Durations look like 3d, 2w, 6m, 1y. Dates are MM-DD. Conditions look like soil_temp_5day_avg_f:50.",
          "data": {
            "every": "Every",
            "anchor": "Anchor date (YYYY-MM-DD)",
            "first_due": "First due date (YYYY-MM-DD)",
            "days": "Days of month (e.g. 1,15)",
            "next_business_day": "Move weekends to Monday",
            "opens": "Opens (MM-DD)",
            "due": "Due (MM-DD)",
            "not_before": "Not before (MM-DD)",
            "not_after": "Not after (MM-DD)",
            "when": "Open only when",
            "open_early_when": "Open early when",
            "completes": "Completes these duties (comma separated IDs)",
            "due_in": "Due after signal (e.g. 3d)",
            "opens_before": "Open this long before due"
          }
        },
        "details": {
          "title": "Reminders and details",
          "data": {
            "remind": "Remind (e.g. -3d,0d)",
            "escalate_after": "Escalate to admins after overdue by (e.g. 2d)",
            "how_to": "How to",
            "season": "Active months (e.g. 3,4,5)",
            "done_by": "Can be marked done by",
            "enabled": "Enabled",
            "nfc_tags": "NFC tag IDs that complete this (comma separated; from Settings > Tags)"
          }
        }
      },
      "error": {
        "bad_id": "Use lowercase letters, numbers, - and _.",
        "id_exists": "That ID is already used.",
        "bad_schedule": "That schedule is not valid.",
        "bad_details": "Check the reminder durations and months."
      },
      "abort": {
        "reconfigure_successful": "Saved."
      }
    },
    "biller": {
      "initiate_flow": {
        "user": "Add biller",
        "reconfigure": "Edit biller"
      },
      "entry_type": "Biller",
      "step": {
        "user": {
          "title": "Biller",
          "description": "A sender BillBot reads. Bills open a pay duty. Income (like rent) completes the duties listed under Completes.",
          "data": {
            "id": "ID (short, no spaces)",
            "name": "Name BillBot files it under (e.g. Duke Energy)",
            "kind": "Kind",
            "module": "Module",
            "sender_domains": "Sender domains (comma separated, e.g. duke-energy.com)",
            "owners": "Who pays",
            "observers": "Extra observers",
            "cadence_days": "Expected days between bills (blank = don't check)",
            "grace_days": "Grace days before it is flagged as silent",
            "completes": "Income only: duty IDs completed when money arrives",
            "remind": "Remind (e.g. -3d,0d)",
            "escalate_after": "Escalate to admins after overdue by (e.g. 2d)",
            "enabled": "Enabled"
          }
        }
      },
      "error": {
        "bad_id": "Use lowercase letters, numbers, - and _.",
        "id_exists": "That ID is already used.",
        "bad_details": "Check the numbers and reminder durations."
      },
      "abort": {
        "reconfigure_successful": "Saved."
      }
    }
  },
  "services": {
    "complete": {
      "name": "Complete",
      "description": "Mark a duty done.",
      "fields": {
        "duty_id": {
          "name": "Duty",
          "description": "The id of the duty."
        },
        "by": {
          "name": "Done by",
          "description": "Who did it (a person id). Defaults to the person who owns the duty."
        },
        "method": {
          "name": "Method",
          "description": "How it was completed."
        },
        "note": {
          "name": "Note",
          "description": "Optional note saved in the history."
        }
      }
    },
    "snooze": {
      "name": "Snooze",
      "description": "Hide a duty's reminders until later.",
      "fields": {
        "duty_id": {
          "name": "Duty",
          "description": "The id of the duty."
        },
        "hours": {
          "name": "Hours",
          "description": "Snooze for this many hours."
        },
        "until": {
          "name": "Until",
          "description": "Snooze until this date."
        }
      }
    },
    "skip": {
      "name": "Skip",
      "description": "Skip this occurrence (a reason is required).",
      "fields": {
        "duty_id": {
          "name": "Duty",
          "description": "The id of the duty."
        },
        "reason": {
          "name": "Reason",
          "description": "Why it is being skipped (required)."
        },
        "by": {
          "name": "Skipped by",
          "description": "Who skipped it (a person id)."
        }
      }
    },
    "signal": {
      "name": "Signal",
      "description": "Tell a signal-driven duty that its event happened.",
      "fields": {
        "duty_id": {
          "name": "Duty",
          "description": "The id of the duty to open from an outside signal."
        }
      }
    },
    "reassign": {
      "name": "Reassign",
      "description": "Change who owns a duty.",
      "fields": {
        "duty_id": {
          "name": "Duty",
          "description": "The id of the duty."
        },
        "owners": {
          "name": "Owners",
          "description": "Person ids; the first is the primary owner."
        }
      }
    },
    "import_pack": {
      "name": "Import pack",
      "description": "Import duties from a YAML pack.",
      "fields": {
        "pack": {
          "name": "Pack YAML",
          "description": "Paste the pack YAML text."
        },
        "path": {
          "name": "File path",
          "description": "Path to a pack file inside your Home Assistant config folder."
        },
        "overwrite": {
          "name": "Overwrite",
          "description": "Replace duties that already exist."
        },
        "dry_run": {
          "name": "Dry run",
          "description": "Check the pack and report what would change, without changing anything."
        }
      }
    },
    "export_pack": {
      "name": "Export pack",
      "description": "Export a module as a YAML pack.",
      "fields": {
        "module": {
          "name": "Module",
          "description": "The module id to export."
        }
      }
    }
  }
}
